{
  "id": "soluma-sunrise",
  "name": "Soluma Sunrise",
  "version": "1.6.0",
  "author": "Soluma",
  "description": "Soluma's webmail theme: warm Paper & Graphite grounds, Geist type, ink actions, an always-dark navigation rail, and the Sunrise gradient kept for small marks (what is current, what is unread, Compose).",
  "type": "theme",
  "apiVersion": 2,
  "minAppVersion": "1.21.0",
  "variants": ["light", "dark"],
  "preview": "preview.svg",
  "icon": "icon.png",
  "banner": "banner.png",
  "density": "normal",
  "radii": {
    "sm": "6px",
    "md": "8px",
    "lg": "10px",
    "xl": "12px",
    "full": "999px"
  },
  "typography": {
    "fontSans": "\"Geist\", \"Geist Fallback\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", \"Helvetica Neue\", \"Noto Sans\", \"Noto Sans Thai\", \"Leelawadee UI\", sans-serif",
    "fontMono": "\"Geist Mono\", \"Geist Mono Fallback\", \"GeistMono Nerd Font\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "fontDisplay": "\"Geist\", \"Geist Fallback\", ui-sans-serif, system-ui, -apple-system, \"Helvetica Neue\", sans-serif",
    "baseFontSize": "100%"
  },
  "print": {
    "fontFamily": "\"Geist\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "headingFontFamily": "\"Geist\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "textColor": "#202125",
    "headingColor": "#202125",
    "ruleColor": "#A8A39A",
    "pageMargin": "16mm"
  },
  "tokens": {
    "common": {
      "--soluma-graphite": "#202125",
      "--soluma-paper": "#FFFDF8",
      "--soluma-ivory": "#F6F0E6",
      "--soluma-rose": "#F03D6E",
      "--soluma-coral": "#FF6A45",
      "--soluma-amber": "#FFA640",
      "--soluma-gold": "#FFD873",
      "--soluma-sand": "#EDE4D6",
      "--soluma-mist": "#A8A39A",
      "--soluma-stone": "#625E58",
      "--soluma-slate": "#34363C",
      "--soluma-pitch": "#131416",
      "--soluma-step-1": "linear-gradient(90deg, #F03D6E, #FF7A45)",
      "--soluma-step-2": "linear-gradient(90deg, #FF6A45, #FFA640)",
      "--soluma-step-3": "linear-gradient(90deg, #FFA640, #FFD873)",
      "--soluma-sunrise": "linear-gradient(90deg, #F03D6E 0%, #FF6A45 36%, #FFA640 70%, #FFD873 100%)",
      "--soluma-ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "--soluma-ease-step": "cubic-bezier(0.2, 0, 0, 1)",
      "--ext-white": "#FFFFFF",
      "--ext-neutral-66": "#96928A",
      "--ext-neutral-56": "#79746D",
      "--ext-graphite-raised": "#2A2B30"
    },
    "light": {
      "--color-sidebar": "color-mix(in srgb, #202125 calc((2 - sibling-index()) * 100%), #F6F0E6)",
      "--color-primary": "#FDF0CA",
      "--color-primary-foreground": "#202125",
      "--color-muted-foreground": "#96928A",
      "background": "#FFFDF8",
      "foreground": "#202125",
      "card": "#FFFFFF",
      "card-foreground": "#202125",
      "popover": "#FFFFFF",
      "popover-foreground": "#202125",
      "primary": "#202125",
      "primary-foreground": "#F6F0E6",
      "secondary": "#F6F0E6",
      "secondary-foreground": "#202125",
      "muted": "#F1EADF",
      "muted-foreground": "#625E58",
      "accent": "#EDE4D6",
      "accent-foreground": "#202125",
      "destructive": "#BE2323",
      "destructive-foreground": "#FFFDF8",
      "border": "#EDE4D6",
      "input": "#96928A",
      "ring": "#202125",
      "sidebar": "#F6F0E6",
      "sidebar-foreground": "#202125",
      "sidebar-border": "#EDE4D6",
      "sidebar-accent": "#FFFFFF",
      "sidebar-accent-foreground": "#202125",
      "success": "#126635",
      "success-foreground": "#FFFDF8",
      "warning": "#7F4E07",
      "warning-foreground": "#FFFDF8",
      "info": "#375998",
      "info-foreground": "#FFFDF8",
      "note": "#FFF2D2",
      "note-foreground": "#202125",
      "note-border": "#F7D494",
      "selection": "#FDF0CA",
      "selection-foreground": "#202125",
      "unread": "#F03D6E",
      "chart-1": "#F03D6E",
      "chart-2": "#2EA55D",
      "chart-3": "#D47B0F",
      "chart-4": "#E5532B",
      "chart-5": "#6290E7"
    },
    "dark": {
      "--color-sidebar": "color-mix(in srgb, #131416 calc((2 - sibling-index()) * 100%), #1A1B1E)",
      "--color-primary": "#3D392E",
      "--color-primary-foreground": "#F6F0E6",
      "background": "#202125",
      "foreground": "#F6F0E6",
      "card": "#2A2B30",
      "card-foreground": "#F6F0E6",
      "popover": "#34363C",
      "popover-foreground": "#F6F0E6",
      "primary": "#F6F0E6",
      "primary-foreground": "#202125",
      "secondary": "#1A1B1E",
      "secondary-foreground": "#F6F0E6",
      "muted": "#2A2B30",
      "muted-foreground": "#A8A39A",
      "accent": "#34363C",
      "accent-foreground": "#F6F0E6",
      "destructive": "#F97770",
      "destructive-foreground": "#202125",
      "border": "#34363C",
      "input": "#79746D",
      "ring": "#F6F0E6",
      "sidebar": "#1A1B1E",
      "sidebar-foreground": "#F6F0E6",
      "sidebar-border": "#34363C",
      "sidebar-accent": "#2A2B30",
      "sidebar-accent-foreground": "#F6F0E6",
      "success": "#79CD91",
      "success-foreground": "#202125",
      "warning": "#FFD873",
      "warning-foreground": "#202125",
      "info": "#94B8F8",
      "info-foreground": "#202125",
      "note": "#382C11",
      "note-foreground": "#F6F0E6",
      "note-border": "#604914",
      "selection": "#3D392E",
      "selection-foreground": "#F6F0E6",
      "unread": "#FF6A45",
      "chart-1": "#F03D6E",
      "chart-2": "#79CD91",
      "chart-3": "#FFA640",
      "chart-4": "#FF6A45",
      "chart-5": "#94B8F8"
    }
  }
}
